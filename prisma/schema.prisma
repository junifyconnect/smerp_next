// ==================== 경영팀: 매출 계산서 발행 현황 ====================

model SalesInvoiceStatus {
  id String @id @default(uuid())

  // 품의서 연결
  approvalCode    String? @map("approval_code") // Y251201-01 형식
  salesApprovalId String? @map("sales_approval_id")
  maApprovalId    String? @map("ma_approval_id")

  // 품목 정보
  partNumber String? @map("part_number") // P/N
  itemName   String  @map("item_name") // 품목명

  // 매출 정보
  clientCompany String  @map("client_company") // 매출처
  quantity      Int     @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 2)
  totalPrice    Decimal @map("total_price") @db.Decimal(15, 2)
  batchTotal    Decimal? @map("batch_total") @db.Decimal(15, 2) // 건별합계

  // 계산서 발행
  invoiceDate   DateTime? @map("invoice_date") @db.Date
  invoiceStatus String?   @map("invoice_status") // 발행완료, 미발행, 반품

  // 결제 정보
  paidAmount    Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2) // 결제된 금액
  remainAmount  Decimal?  @map("remain_amount") @db.Decimal(15, 2) // 잔액 (totalPrice - paidAmount)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  // 기타
  remarks   String? @db.Text // 기타사항 (담당자, 매입처 등)
  yearMonth String? @map("year_month") // 25.12 형식 (시트 구분용)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 결제 내역 관계
  paymentHistories SalesPaymentHistory[]

  @@index([approvalCode])
  @@index([clientCompany])
  @@index([yearMonth])
  @@index([invoiceDate])
  @@index([paymentStatus])
  @@map("sales_invoice_status")
}

// ==================== 경영팀: 매입 계산서 발행 현황 ====================

