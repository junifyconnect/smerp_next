generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== NextAuth 세션 ====================

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ==================== 사용자 & 권한 ====================

model User {
  id              String   @id @default(uuid())
  employeeId      String?  @unique @map("employee_id") // 사번 (예: hmlee, shseo)
  email           String   @unique
  passwordHash    String?  @map("password_hash")
  name            String
  phone           String?
  department      String? // SALES, MA, FINANCE, ADMIN (소속팀)
  position        String? // 직급 (부장, CEO, 대리, 실장, 사원, 인턴 등)
  role            String? // 권한 (영업, CEO, 기술, 관리자)
  annualLeave     Float    @default(0) @map("annual_leave") // 연차
  additionalLeave Float    @default(0) @map("additional_leave") // 추가휴가
  signatureUrl    String?  @map("signature_url") // S3 서명 이미지 경로
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // NextAuth 관계
  sessions Session[]

  roles           UserRole[]
  menuPermissions UserMenuPermission[]
  excelImports    ExcelImport[]        @relation("ImportedBy")

  // SalesQuote relations
  salesQuotes     SalesQuote[]     @relation("SalesQuoteCreatedBy")
  salesQuoteFiles SalesQuoteFile[] @relation("SalesQuoteFileUploadedBy")

  // SalesApproval relations
  salesApprovalFiles SalesApprovalFile[] @relation("SalesApprovalFileUploadedBy")

  // SalesOrder relations
  salesOrders     SalesOrder[]     @relation("SalesOrderCreatedBy")
  salesOrderFiles SalesOrderFile[] @relation("SalesOrderFileUploadedBy")

  // SalesApproval signature relations
  salesManagerApprovals SalesApproval[] @relation("SalesManagerSigner")
  teamLeaderApprovals   SalesApproval[] @relation("TeamLeaderSigner")
  ceoApprovals          SalesApproval[] @relation("CeoSigner")
  rejectedApprovals     SalesApproval[] @relation("ApprovalRejector")

  // MAApproval signature relations
  maSalesManagerApprovals MAApproval[] @relation("MASalesManagerSigner")
  maTeamLeaderApprovals   MAApproval[] @relation("MATeamLeaderSigner")
  maCeoApprovals          MAApproval[] @relation("MACeoSigner")
  maRejectedApprovals     MAApproval[] @relation("MAApprovalRejector")

  // 알림
  notifications Notification[]

  // 캘린더
  calendarEvents       CalendarEvent[]            @relation("CalendarEventOwner")
  calendarParticipants CalendarEventParticipant[] @relation("CalendarEventParticipant")

  // 휴가
  leaveRequests LeaveRequest[]

  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique // ADMIN, SALES_MANAGER, SALES_STAFF, MA_MANAGER, MA_STAFF, FINANCE
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId Int    @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==================== 메뉴 권한 ====================

enum PermissionLevel {
  NONE // 접근 불가
  READ // 조회만 가능
  FULL // 생성/수정/삭제 가능
}

model UserMenuPermission {
  id     String          @id @default(uuid())
  userId String          @map("user_id")
  menu   String // SALES_QUOTE, SALES_APPROVAL, SALES_ORDER, MA_QUOTE, MA_APPROVAL, CLOUD, USER_MANAGEMENT
  level  PermissionLevel @default(NONE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menu])
  @@index([userId])
  @@map("user_menu_permissions")
}

// ==================== 파일 타입 ====================

enum FileType {
  EXCEL_ORIGINAL // 업로드된 원본
  EXCEL_GENERATED // 시스템 생성
  CLIENT_PO // 고객 발주서
  ATTACHMENT // 일반 첨부
  SIGNED_ORIGINAL // 직인 찍힌 원본
}

// ==================== Deal 제거됨 (v2) ====================

// ==================== 거래처 (Customer) ====================

model Customer {
  id        String   @id @default(uuid())
  name      String   @unique // 매출처명 (법인명 또는 회사명)
  phone     String? // 대표 전화
  fax       String? // 대표 팩스
  address   String? // 주소
  notes     String?  @db.Text // 비고
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 담당자 목록
  contacts CustomerContact[]

  @@index([name])
  @@index([isActive])
  @@map("customers")
}

// 거래처 담당자
model CustomerContact {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String // 담당자명
  department String? // 부서
  position   String? // 직급
  phone      String? // 전화
  mobile     String? // 휴대폰 (C.P)
  email      String? // 이메일
  isDefault  Boolean  @default(false) @map("is_default") // 기본 담당자 여부
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([isActive])
  @@map("customer_contacts")
}

// ==================== 매입처 (Vendor) ====================

model Vendor {
  id          String   @id @default(uuid())
  name        String   @unique // 매입처명
  contactName String?  @map("contact_name") // 담당자명
  phone       String? // 전화
  email       String? // 이메일
  notes       String?  @db.Text // 비고
  usageCount  Int      @default(0) @map("usage_count") // 사용 횟수 (정렬용)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([usageCount(sort: Desc)])
  @@index([isActive])
  @@map("vendors")
}

// ==================== 영업 견적서 (SalesQuote) ====================

enum QuoteStatus {
  DRAFT // 작성중
  SENT // 발송됨
  ACCEPTED // 수락됨
  REJECTED // 거절됨
}

model SalesQuote {
  id     String      @id @default(uuid())
  status QuoteStatus @default(DRAFT)

  // 프로젝트/물품 정보
  projectName String? @map("project_name")
  productName String? @map("product_name") // 물품명 (식별용)
  managerName String? @map("manager_name") // 담당자

  // 매출처 (고객) 정보
  clientCompany String? @map("client_company")
  clientContact String? @map("client_contact") // 참조 (담당자)
  clientPhone   String? @map("client_phone") // 전화
  clientFax     String? @map("client_fax") // Fax
  clientMobile  String? @map("client_mobile") // CP (휴대폰)
  clientEmail   String? @map("client_email")

  // 금액
  totalAmount  Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)
  vatAmount    Decimal @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalWithVat Decimal @default(0) @map("total_with_vat") @db.Decimal(15, 2)

  // 날짜 및 조건
  quoteDate    DateTime? @map("quote_date") @db.Date
  validUntil   String?   @map("valid_until") // 유효기간 (텍스트: "견적일로부터 15일")
  deliveryDate DateTime? @map("delivery_date") @db.Date
  paymentTerms String?   @map("payment_terms")

  // 기타
  notes String? @db.Text

  // 버전 관리
  version    Int     @default(1) // 버전 번호
  originalId String? @map("original_id") // 최초 버전 ID (v1은 null)
  isLatest   Boolean @default(true) @map("is_latest") // 최신 버전 여부

  original SalesQuote?  @relation("QuoteVersions", fields: [originalId], references: [id])
  versions SalesQuote[] @relation("QuoteVersions")

  // 메타
  createdById String?  @map("created_by")
  createdBy   User?    @relation("SalesQuoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 관계
  products       SalesQuoteProduct[] // 제품 그룹들
  files          SalesQuoteFile[]
  salesApprovals SalesApproval[] // 이 견적서를 기반으로 생성된 품의서들

  @@index([status])
  @@index([isLatest])
  @@index([createdById])
  @@index([clientCompany])
  @@index([quoteDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("sales_quotes")
}

// 제품 그룹 (통합 견적)
model SalesQuoteProduct {
  id      String @id @default(uuid())
  quoteId String @map("quote_id")

  sortOrder  Int      @default(0) @map("sort_order")
  name       String // 제품명 (예: "영상편집용 조립PC")
  quantity   Int      @default(1)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(15, 2)
  totalPrice Decimal? @map("total_price") @db.Decimal(15, 2)

  quote     SalesQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items     SalesQuoteItem[]
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([quoteId])
  @@map("sales_quote_products")
}

model SalesQuoteItem {
  id        String @id @default(uuid())
  productId String @map("product_id")

  sortOrder   Int      @default(0) @map("sort_order")
  partNumber  String?  @map("part_number") // P/N
  description String?  @db.Text // 품명/스펙
  quantity    Int      @default(1)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(15, 2) // 개별 매출단가 (선택)
  totalPrice  Decimal? @map("total_price") @db.Decimal(15, 2)

  product   SalesQuoteProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([productId])
  @@map("sales_quote_items")
}

model SalesQuoteFile {
  id       String   @id @default(uuid())
  quoteId  String   @map("quote_id")
  fileType FileType @map("file_type")
  fileName String   @map("file_name")
  filePath String   @map("file_path") // S3 key
  fileSize Int?     @map("file_size")
  mimeType String?  @map("mime_type")

  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation("SalesQuoteFileUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  quote SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("sales_quote_files")
}

// ==================== 영업 품의서 (SalesApproval) ====================

enum ApprovalStatus {
  DRAFT // 작성중
  PENDING // 승인대기 (레거시 - 이전 버전 호환용)
  PENDING_TEAM_LEAD // 영업팀장 승인대기
  PENDING_CEO // 대표이사 승인대기
  APPROVED // 승인완료
  REJECTED // 반려
}

model SalesApproval {
  id             String         @id @default(uuid())
  approvalNumber String         @unique @map("approval_number") // SA-2025-0001
  status         ApprovalStatus @default(DRAFT)

  // 원본 견적서 연결 (견적서 기반 품의서 작성 시)
  sourceQuoteId String?     @map("source_quote_id")
  sourceQuote   SalesQuote? @relation(fields: [sourceQuoteId], references: [id])

  // 기본 정보
  approvalCode String?   @map("approval_code") // 품의코드 (D251202-01) - 버전 간 공유
  approvalDate DateTime? @map("approval_date") @db.Date
  managerName  String?   @map("manager_name") // 품의담당

  // 버전 관리
  version    Int     @default(1) // 버전 번호
  originalId String? @map("original_id") // 최초 버전 ID (v1은 null)
  isLatest   Boolean @default(true) @map("is_latest") // 최신 버전 여부

  original SalesApproval?  @relation("ApprovalVersions", fields: [originalId], references: [id])
  versions SalesApproval[] @relation("ApprovalVersions")

  // 매출처 정보
  clientCompany String? @map("client_company")
  clientContact String? @map("client_contact")
  clientPhone   String? @map("client_phone")
  endUser       String? @map("end_user")

  // 금액 (자동 계산)
  totalSalesAmount    Decimal @default(0) @map("total_sales_amount") @db.Decimal(15, 2)
  totalPurchaseAmount Decimal @default(0) @map("total_purchase_amount") @db.Decimal(15, 2)
  profitAmount        Decimal @default(0) @map("profit_amount") @db.Decimal(15, 2) // 매출-매입

  // 조건
  paymentTerms    String?   @map("payment_terms")
  deliveryAddress String?   @map("delivery_address")
  deliveryDate    DateTime? @map("delivery_date") @db.Date
  invoiceEmail    String?   @map("invoice_email")
  receiverName    String?   @map("receiver_name")
  receiverPhone   String?   @map("receiver_phone")

  notes String? @db.Text

  // 결재/서명 정보
  // 영업담당자 서명 (1단계)
  salesManagerId       String?   @map("sales_manager_id")
  salesManager         User?     @relation("SalesManagerSigner", fields: [salesManagerId], references: [id])
  salesManagerSignedAt DateTime? @map("sales_manager_signed_at")

  // 영업팀장 서명 (2단계)
  teamLeaderId       String?   @map("team_leader_id")
  teamLeader         User?     @relation("TeamLeaderSigner", fields: [teamLeaderId], references: [id])
  teamLeaderSignedAt DateTime? @map("team_leader_signed_at")

  // 대표이사 서명 (3단계)
  ceoId       String?   @map("ceo_id")
  ceo         User?     @relation("CeoSigner", fields: [ceoId], references: [id])
  ceoSignedAt DateTime? @map("ceo_signed_at")

  // 반려 정보
  rejectedById    String?   @map("rejected_by_id")
  rejectedBy      User?     @relation("ApprovalRejector", fields: [rejectedById], references: [id])
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason") @db.Text

  // 메타
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 관계
  products       SalesApprovalProduct[]
  files          SalesApprovalFile[]
  invoiceRecords InvoiceRecord[] // 계산서 발행 기록

  @@unique([approvalCode, version]) // 같은 품의코드 내 버전은 고유
  @@index([status])
  @@index([createdById])
  @@index([salesManagerId])
  @@index([teamLeaderId])
  @@index([ceoId])
  @@index([createdAt(sort: Desc)])
  @@index([approvalCode])
  @@index([isLatest])
  @@index([originalId])
  @@map("sales_approvals")
}

// ★ 품의서 제품 (매출 단위)
model SalesApprovalProduct {
  id         String @id @default(uuid())
  approvalId String @map("approval_id")

  sortOrder  Int      @default(0) @map("sort_order")
  name       String // 제품명 (예: "영상편집용 조립PC")
  quantity   Int      @default(1)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(15, 2) // 매출 단가
  totalPrice Decimal? @map("total_price") @db.Decimal(15, 2) // 매출 합계

  // 분류 (원장 연동용)
  // 실무 규칙: 상품(영업 품의서) / MA(MA 품의서) 2종만 사용
  // 세금은 VAT 10% 고정, 매출 계산서는 항상 제품 단위(PRODUCT) 발행
  category    ProductCategory @default(상품)
  subCategory String?         @map("sub_category") // 세부분류 (월간-IBM 등)

  // 버전 추적 (revise 시 원본 Product ID)
  sourceProductId String? @map("source_product_id")

  approval SalesApproval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  items    SalesApprovalItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([approvalId])
  @@index([sourceProductId])
  @@map("sales_approval_products")
}

// ★ 품의서 품목 (개별 부품 + 매입 정보)
model SalesApprovalItem {
  id        String @id @default(uuid())
  productId String @map("product_id")

  sortOrder   Int     @default(0) @map("sort_order")
  partNumber  String? @map("part_number") // P/N (예: CPU, BOARD)
  description String? @db.Text // 상세 스펙

  // 매출 (선택 - 품목별 매출가 필요할 때)
  quantity       Int      @default(1)
  salesUnitPrice Decimal? @map("sales_unit_price") @db.Decimal(15, 2) // nullable 예비

  // 매입
  vendorName    String?   @map("vendor_name") // 매입처명
  purchaseQty   Int       @default(1) @map("purchase_qty")
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(15, 2) // 매입 단가
  purchaseTotal Decimal?  @map("purchase_total") @db.Decimal(15, 2) // 매입 합계
  purchaseDate  DateTime? @map("purchase_date") @db.Date // 매입일

  // 계산서 발행 대상 여부 (체크 해제 시 InvoiceRecord 미생성)
  salesInvoiceRequired    Boolean @default(true) @map("sales_invoice_required")
  purchaseInvoiceRequired Boolean @default(true) @map("purchase_invoice_required")

  // 버전 추적
  sourceItemId String? @map("source_item_id")

  product   SalesApprovalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([productId])
  @@index([vendorName])
  @@index([sourceItemId])
  @@map("sales_approval_items")
}

model SalesApprovalFile {
  id         String   @id @default(uuid())
  approvalId String   @map("approval_id")
  fileType   FileType @map("file_type")
  fileName   String   @map("file_name")
  filePath   String   @map("file_path") // S3 key
  fileSize   Int?     @map("file_size")
  mimeType   String?  @map("mime_type")

  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation("SalesApprovalFileUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  approval SalesApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("sales_approval_files")
}

// ==================== 영업 발주서 (SalesOrder) ====================

enum OrderStatus {
  DRAFT // 작성중
  SENT // 발송완료
  CONFIRMED // 확인됨
  DELIVERED // 납품완료
  CANCELLED // 취소
}

model SalesOrder {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number") // SO-2025-0001
  status      OrderStatus @default(DRAFT)

  // 발주 정보
  orderDate       DateTime? @map("order_date") @db.Date
  managerName     String?   @map("manager_name")
  managerPhone    String?   @map("manager_phone")
  deliveryAddress String?   @map("delivery_address")
  paymentTerms    String?   @map("payment_terms")

  // 매입처 정보
  vendorCompany String? @map("vendor_company")
  vendorContact String? @map("vendor_contact")
  vendorPhone   String? @map("vendor_phone")
  vendorEmail   String? @map("vendor_email")

  // 금액
  totalAmount  Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)
  vatAmount    Decimal @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalWithVat Decimal @default(0) @map("total_with_vat") @db.Decimal(15, 2)

  notes String? @db.Text

  // 버전 관리
  version    Int     @default(1) // 버전 번호
  originalId String? @map("original_id") // 최초 버전 ID (v1은 null)
  isLatest   Boolean @default(true) @map("is_latest") // 최신 버전 여부

  original SalesOrder?  @relation("OrderVersions", fields: [originalId], references: [id])
  versions SalesOrder[] @relation("OrderVersions")

  // 메타
  createdById String   @map("created_by")
  createdBy   User     @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 관계
  items SalesOrderItem[]
  files SalesOrderFile[]

  @@index([status])
  @@index([createdById])
  @@index([isLatest])
  @@index([createdAt(sort: Desc)])
  @@map("sales_orders")
}

model SalesOrderFile {
  id       String   @id @default(uuid())
  orderId  String   @map("order_id")
  fileType FileType @map("file_type")
  fileName String   @map("file_name")
  filePath String   @map("file_path") // S3 key
  fileSize Int?     @map("file_size")
  mimeType String?  @map("mime_type")

  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation("SalesOrderFileUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("sales_order_files")
}

model SalesOrderItem {
  id      String @id @default(uuid())
  orderId String @map("order_id")

  sortOrder   Int      @default(0) @map("sort_order")
  partNumber  String?  @map("part_number")
  description String?  @db.Text
  quantity    Int      @default(1)
  srpPrice    Decimal? @map("srp_price") @db.Decimal(15, 2)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(15, 2)
  totalPrice  Decimal? @map("total_price") @db.Decimal(15, 2)

  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([orderId])
  @@map("sales_order_items")
}

// ==================== MA 견적서 (MAQuote) ====================

model MAQuote {
  id          String      @id @default(uuid())
  quoteNumber String      @unique @map("quote_number") // MQ-2025-0001
  status      QuoteStatus @default(DRAFT)

  // 기본 정보
  quoteDate   DateTime? @map("quote_date") @db.Date
  managerName String?   @map("manager_name")

  // 고객 정보
  clientCompany String? @map("client_company")
  clientContact String? @map("client_contact")

  // 금액
  totalAmount  Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)
  vatAmount    Decimal @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalWithVat Decimal @default(0) @map("total_with_vat") @db.Decimal(15, 2)

  // 조건
  validUntil   String? @map("valid_until")
  paymentTerms String? @map("payment_terms")
  serviceTerms String? @map("service_terms") @db.Text
  specialTerms String? @map("special_terms") @db.Text

  notes String? @db.Text

  // 메타
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 관계
  items MAQuoteItem[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
  @@map("ma_quotes")
}

model MAQuoteItem {
  id      String @id @default(uuid())
  quoteId String @map("quote_id")

  sortOrder    Int       @default(0) @map("sort_order")
  productName  String?   @map("product_name") // 기기명
  modelType    String?   @map("model_type") // M/T
  model        String? // Model
  serialNumber String?   @map("serial_number") // S/N
  serviceLevel String?   @map("service_level") // 서비스 레벨
  period       String? // 기간 (1년)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  totalPrice   Decimal?  @map("total_price") @db.Decimal(15, 2)

  quote     MAQuote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([quoteId])
  @@map("ma_quote_items")
}

// ==================== MA 품의서 (MAApproval) ====================

model MAApproval {
  id             String         @id @default(uuid())
  approvalNumber String         @unique @map("approval_number") // MA-2026-0001
  approvalCode   String?        @map("approval_code") // 영업과 동일한 작성자 기반 코드 (예: H260422-01)
  status         ApprovalStatus @default(DRAFT)

  // 기본 정보
  approvalDate DateTime? @map("approval_date") @db.Date
  managerName  String?   @map("manager_name")

  // 금액
  totalAmount   Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)
  purchaseTotal Decimal @default(0) @map("purchase_total") @db.Decimal(15, 2)

  notes String? @db.Text

  // 버전 관리 (revise 지원)
  version    Int     @default(1)
  originalId String? @map("original_id") // 최초 버전 ID (v1은 null)
  isLatest   Boolean @default(true) @map("is_latest")

  original MAApproval?  @relation("MAApprovalVersions", fields: [originalId], references: [id])
  versions MAApproval[] @relation("MAApprovalVersions")

  // 결재/서명 정보 (BUSINESS_RULES §5 — 상신 시 명시적 지정)
  // 영업담당자 서명 (1단계)
  salesManagerId       String?   @map("sales_manager_id")
  salesManager         User?     @relation("MASalesManagerSigner", fields: [salesManagerId], references: [id])
  salesManagerSignedAt DateTime? @map("sales_manager_signed_at")

  // 영업팀장 서명 (2단계)
  teamLeaderId       String?   @map("team_leader_id")
  teamLeader         User?     @relation("MATeamLeaderSigner", fields: [teamLeaderId], references: [id])
  teamLeaderSignedAt DateTime? @map("team_leader_signed_at")

  // 대표이사 서명 (3단계)
  ceoId       String?   @map("ceo_id")
  ceo         User?     @relation("MACeoSigner", fields: [ceoId], references: [id])
  ceoSignedAt DateTime? @map("ceo_signed_at")

  // 반려 정보
  rejectedById    String?   @map("rejected_by_id")
  rejectedBy      User?     @relation("MAApprovalRejector", fields: [rejectedById], references: [id])
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason") @db.Text

  // 메타
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 관계
  items         MAApprovalItem[]
  purchaseItems MAApprovalPurchaseItem[] // deprecated: 기존 데이터 호환용
  contracts     MAContract[] // APPROVED 시 생성되는 계약

  @@unique([approvalCode, version]) // 같은 품의코드 내 버전은 고유 (nullable이라 NULL 끼리는 충돌 안 남)
  @@index([status])
  @@index([createdById])
  @@index([salesManagerId])
  @@index([teamLeaderId])
  @@index([ceoId])
  @@index([createdAt(sort: Desc)])
  @@index([approvalCode])
  @@index([isLatest])
  @@index([originalId])
  @@map("ma_approvals")
}

model MAApprovalItem {
  id         String @id @default(uuid())
  approvalId String @map("approval_id")

  sortOrder       Int       @default(0) @map("sort_order")
  smCode          String?   @map("sm_code")
  vendorCode      String?   @map("vendor_code")
  clientCompany   String?   @map("client_company") // 고객사
  salesCompany    String?   @map("sales_company") // 매출처
  salesPrice      Decimal?  @map("sales_price") @db.Decimal(15, 2) // 1회 청구당 매출가
  quantity        Int       @default(1)
  salesBillingCycle BillingCycle? @map("sales_billing_cycle") // 매출 청구 주기
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  purchaseCompany String?   @map("purchase_company") // 매입처
  purchasePrice   Decimal?  @map("purchase_price") @db.Decimal(15, 2) // 1회 청구당 매입가
  purchaseBillingCycle BillingCycle? @map("purchase_billing_cycle") // 매입 청구 주기

  // 청구 기준일 (매월 몇일에 청구할지, BUSINESS_RULES §10.3)
  billingDayOfMonth Int @default(31) @map("billing_day_of_month")

  approval  MAApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([approvalId])
  @@map("ma_approval_items")
}

model MAApprovalPurchaseItem {
  id         String @id @default(uuid())
  approvalId String @map("approval_id")

  sortOrder     Int      @default(0) @map("sort_order")
  vendorCompany String?  @map("vendor_company")
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(15, 2)
  quantity      Int      @default(1)
  billingType   String?  @map("billing_type")

  approval  MAApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([approvalId])
  @@map("ma_approval_purchase_items")
}

// 청구 주기 (MA 품의서 전용, BUSINESS_RULES §10.3)
enum BillingCycle {
  매월
  격월
  분기
  반기
  연간
  일시불
}

// ==================== MA 계약 (MAContract) ====================
// MA 품의서 APPROVED 시 자동 생성. 계약 루트 엔티티.
model MAContract {
  id             String   @id @default(uuid())
  maApprovalId   String   @map("ma_approval_id")

  // 체인 루트 (revise 시 v1 계약의 id를 유지)
  rootApprovalId String   @map("root_approval_id")
  approvalVersion Int     @default(1) @map("approval_version")

  // 스냅샷 (계약 체결 시점 내용)
  clientCompany  String   @map("client_company")
  contractStartDate DateTime @map("contract_start_date") @db.Date
  contractEndDate   DateTime @map("contract_end_date") @db.Date

  // 활성 상태 (revise 시 이전 계약 비활성화)
  isActive     Boolean   @default(true) @map("is_active")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  maApproval MAApproval @relation(fields: [maApprovalId], references: [id], onDelete: Cascade)
  billings   MABilling[]

  @@index([maApprovalId])
  @@index([rootApprovalId])
  @@index([isActive])
  @@map("ma_contracts")
}

// ==================== MA 청구 스케줄 (MABilling) ====================
// MA 원장 역할. 영업의 SalesLedger/PurchaseLedger와 병렬 존재 (BUSINESS_RULES §10.1).
// 계산서(InvoiceRecord)는 issue 시 MABilling에서 파생 생성됨 (B-2).
model MABilling {
  id           String   @id @default(uuid())
  maContractId String   @map("ma_contract_id")

  billingMonth DateTime @map("billing_month") @db.Date // 해당 월 1일 (2026-04-01)
  dueDate      DateTime @map("due_date") @db.Date      // 실제 청구일 (billingMonth + billingDayOfMonth - 1)

  // 금액 (한 행에 매출·매입 같이 — BUSINESS_RULES §10.1)
  salesAmount    Decimal @default(0) @map("sales_amount") @db.Decimal(15, 2) // 1회 매출가 (주기에 따라 이 달 청구 없으면 0)
  purchaseAmount Decimal @default(0) @map("purchase_amount") @db.Decimal(15, 2)
  salesVatAmount Decimal @default(0) @map("sales_vat_amount") @db.Decimal(15, 2) // VAT 10% 고정
  purchaseVatAmount Decimal @default(0) @map("purchase_vat_amount") @db.Decimal(15, 2)
  salesTotalAmount Decimal @default(0) @map("sales_total_amount") @db.Decimal(15, 2) // 공급가액 + VAT
  purchaseTotalAmount Decimal @default(0) @map("purchase_total_amount") @db.Decimal(15, 2)

  // 스냅샷 (발행 시점 내용)
  clientCompany String  @map("client_company")
  vendorCompany String? @map("vendor_company")
  itemName      String  @map("item_name")

  // 활성 상태 (revise 시 이전 billing 비활성화, 영업 원장과 동일 패턴)
  isActive     Boolean   @default(true) @map("is_active")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  // 원본 역참조
  sourceItemId    String? @map("source_item_id") // MAApprovalItem.id
  approvalVersion Int?    @map("approval_version")

  // 결제
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentDate   DateTime?     @map("payment_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  maContract     MAContract      @relation(fields: [maContractId], references: [id], onDelete: Cascade)
  invoiceRecords InvoiceRecord[] // 이 MABilling에서 파생된 계산서들

  @@index([maContractId])
  @@index([billingMonth])
  @@index([dueDate])
  @@index([clientCompany])
  @@index([vendorCompany])
  @@index([paymentStatus])
  @@index([isActive])
  @@map("ma_billings")
}

// ==================== 엑셀 일괄 업로드 ====================

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExcelImport {
  id       String       @id @default(uuid())
  fileName String       @map("file_name")
  filePath String       @map("file_path")
  status   ImportStatus @default(PENDING)

  totalCount   Int   @default(0) @map("total_count")
  successCount Int   @default(0) @map("success_count")
  errorCount   Int   @default(0) @map("error_count")
  errorLog     Json? @map("error_log")

  importedById String   @map("imported_by")
  importedBy   User     @relation("ImportedBy", fields: [importedById], references: [id])
  importedAt   DateTime @default(now()) @map("imported_at")

  @@map("excel_imports")
}

// ==================== 알림 시스템 ====================

enum NotificationType {
  APPROVAL_REQUEST // 결재 요청
  APPROVAL_APPROVED // 결재 승인
  APPROVAL_REJECTED // 결재 반려
  MA_EXPIRING // MA 만료 예정
  PAYMENT_DUE // 결제 예정
  SYSTEM // 시스템 알림
}

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 알림 내용
  type    NotificationType
  title   String // 알림 제목
  message String           @db.Text // 알림 내용

  // 링크 정보 (클릭 시 이동)
  linkUrl  String? @map("link_url") // 이동할 URL
  linkType String? @map("link_type") // SALES_APPROVAL, MA_APPROVAL, INVOICE 등

  // 연관 데이터 (선택)
  relatedId   String? @map("related_id") // 관련 문서 ID
  relatedType String? @map("related_type") // SalesApproval, MAApproval 등

  // 상태
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("notifications")
}

// ==================== 경영팀: 결제 상태 ====================

enum PaymentStatus {
  PENDING // 미결제
  PARTIAL // 부분결제
  COMPLETED // 결제완료
  OVERDUE // 연체
}

// ==================== 경영팀: 매입장 유형 ====================

enum PurchaseLedgerType {
  INVOICE // 세금계산서
  CASH // 현금영수증
  CARD // 법인카드
  IMPORT // 수입
}

// ==================== 경영팀: 매출장 (Sales Ledger) ====================

model SalesLedger {
  id String @id @default(uuid())

  // 식별 정보
  approvalCode String? @map("approval_code") // 품의코드
  vendorCode   String? @map("vendor_code") // Vendor 코드 (IK-22025 등)

  // 거래 정보
  transactionDate DateTime @map("transaction_date") @db.Date // 거래일
  clientCompany   String   @map("client_company") // 매출처
  endUser         String?  @map("end_user") // END-USER

  // 분류 (상품 / MA)
  category    ProductCategory
  subCategory String?         @map("sub_category") // 월간-IBM, 월간-레노버, 스위치 등

  // 거래 내용
  description  String  @db.Text // 거래내용
  quantity     Int     @default(1)
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 2)
  supplyAmount Decimal @map("supply_amount") @db.Decimal(15, 2) // 공급가액
  vatAmount    Decimal @map("vat_amount") @db.Decimal(15, 2) // 부가세
  totalAmount  Decimal @map("total_amount") @db.Decimal(15, 2) // 합계

  // GP (매출총이익)
  grossProfit Decimal? @map("gross_profit") @db.Decimal(15, 2)

  // 결제 정보
  paymentDueDate DateTime?     @map("payment_due_date") @db.Date // 결제예정일
  paymentDate    DateTime?     @map("payment_date") @db.Date // 실제결제일
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")

  // 담당자
  managerId   String? @map("manager_id")
  managerName String? @map("manager_name") // 이예지, 홍승민 등

  // 연결
  salesApprovalId String? @map("sales_approval_id")
  maApprovalId    String? @map("ma_approval_id")

  // 출처 추적 (원장 ↔ 품의서 역참조)
  sourceProductId String? @map("source_product_id") // 원본 Product ID
  approvalVersion Int?    @map("approval_version") // 품의서 버전

  // 활성 상태 (revise 시 이전 원장 비활성화)
  isActive     Boolean   @default(true) @map("is_active")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([transactionDate])
  @@index([clientCompany])
  @@index([category])
  @@index([paymentStatus])
  @@index([paymentDueDate])
  @@index([managerName])
  @@index([approvalCode])
  @@index([isActive])
  @@map("sales_ledger")
}

// ==================== 경영팀: 매입장 (Purchase Ledger) ====================

model PurchaseLedger {
  id String @id @default(uuid())

  // 식별 정보
  approvalCode String? @map("approval_code") // 품의코드
  vendorCode   String? @map("vendor_code") // Vendor 코드

  // 거래 정보
  invoiceDate   DateTime @map("invoice_date") @db.Date // 계산서 발행일
  vendorCompany String   @map("vendor_company") // 매입처
  clientCompany String?  @map("client_company") // 매출처 (연결된)

  // 분류 (상품 / MA)
  category    ProductCategory
  subCategory String?         @map("sub_category") // 월간-IBM, 지급수수료 등

  // 품목 정보
  itemName     String  @map("item_name") // 품목명
  quantity     Int     @default(1)
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 2)
  supplyAmount Decimal @map("supply_amount") @db.Decimal(15, 2) // 공급가액
  vatAmount    Decimal @map("vat_amount") @db.Decimal(15, 2) // 부가세
  totalAmount  Decimal @map("total_amount") @db.Decimal(15, 2) // 합계

  // 결제 정보
  paymentDueDate DateTime?     @map("payment_due_date") @db.Date // 결제예정일
  paymentDate    DateTime?     @map("payment_date") @db.Date // 실제결제일
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")

  // 특수 유형
  ledgerType PurchaseLedgerType @default(INVOICE) @map("ledger_type")

  // 수입 전용 필드
  currency      String? // 통화 (USD 등)
  foreignAmount Decimal? @map("foreign_amount") @db.Decimal(15, 2) // 외화금액
  exchangeRate  Decimal? @map("exchange_rate") @db.Decimal(10, 4) // 환율

  // 카드 전용 필드
  cardNumber String? @map("card_number")

  // 연결
  salesApprovalId String? @map("sales_approval_id")
  maApprovalId    String? @map("ma_approval_id")

  // 출처 추적 (원장 ↔ 품의서 역참조)
  sourceItemId    String? @map("source_item_id") // 원본 Item ID
  sourceProductId String? @map("source_product_id") // 상위 Product ID
  approvalVersion Int?    @map("approval_version")

  // 활성 상태 (revise 시 이전 원장 비활성화)
  isActive     Boolean   @default(true) @map("is_active")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([invoiceDate])
  @@index([vendorCompany])
  @@index([clientCompany])
  @@index([category])
  @@index([paymentStatus])
  @@index([paymentDueDate])
  @@index([ledgerType])
  @@index([approvalCode])
  @@index([isActive])
  @@map("purchase_ledger")
}

// ==================== 캘린더 시스템 ====================

enum CalendarEventType {
  PERSONAL // 개인 일정
  COMPANY // 사내 전체 일정
  MEETING // 회의
  DEADLINE // 마감일
  HOLIDAY // 휴일/휴가
  MA_EXPIRY // MA 만료
  PAYMENT_DUE // 결제 예정
}

model CalendarEvent {
  id String @id @default(uuid())

  // 이벤트 기본 정보
  title       String // 일정 제목
  description String?           @db.Text // 상세 설명
  eventType   CalendarEventType @default(PERSONAL) @map("event_type")

  // 일시
  startDate DateTime  @map("start_date") // 시작일시
  endDate   DateTime? @map("end_date") // 종료일시 (없으면 하루짜리)
  isAllDay  Boolean   @default(false) @map("is_all_day") // 종일 여부

  // 범위: 개인 vs 전체
  isCompanyWide Boolean @default(false) @map("is_company_wide") // true면 전체 공개

  // 소유자 (개인 일정인 경우)
  userId String? @map("user_id")
  user   User?   @relation("CalendarEventOwner", fields: [userId], references: [id], onDelete: Cascade)

  // 참여자 (회의 등)
  participants CalendarEventParticipant[]

  // 연관 데이터 (MA 만료, 결제 예정 등 자동 생성된 경우)
  relatedId   String? @map("related_id")
  relatedType String? @map("related_type") // MAContract, Invoice 등

  // 반복 설정
  isRecurring   Boolean @default(false) @map("is_recurring")
  recurringRule String? @map("recurring_rule") // DAILY, WEEKLY, MONTHLY, YEARLY

  // 색상 (UI용)
  color String? // #FF5733 형식

  // 알림 설정
  reminderMinutes Int? @map("reminder_minutes") // 몇 분 전 알림 (30, 60, 1440 등)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, startDate])
  @@index([isCompanyWide, startDate])
  @@index([eventType])
  @@index([startDate])
  @@map("calendar_events")
}

model CalendarEventParticipant {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  userId  String @map("user_id")

  // 참여 상태
  status String @default("pending") // pending, accepted, declined

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation("CalendarEventParticipant", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("calendar_event_participants")
}

// ==================== 휴가 관리 시스템 ====================

enum LeaveType {
  ANNUAL // 연차
  HALF_AM // 오전 반차
  HALF_PM // 오후 반차
  SICK // 병가
  FAMILY // 경조사
  OFFICIAL // 공가
  OTHER // 기타
}

enum LeaveStatus {
  APPROVED // 승인 (자동 승인 방식)
  CANCELLED // 취소
}

model LeaveRequest {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 휴가 정보
  leaveType LeaveType @map("leave_type")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  days      Float // 사용 일수 (1, 0.5 등)

  // 사유
  reason String? @db.Text

  // 상태
  status LeaveStatus @default(APPROVED)

  // 연차 차감 여부 (병가, 공가 등은 연차 미차감)
  deductFromAnnual Boolean @default(true) @map("deduct_from_annual")

  // 취소 정보
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?   @map("cancelled_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([startDate])
  @@index([status])
  @@index([leaveType])
  @@map("leave_requests")
}

// ==================== 계산서 발행 기록 ====================

enum InvoiceStatus {
  PENDING // 미발행
  ISSUED // 발행 완료
  NEEDS_AMENDMENT // 수정 필요 (revise로 변경 감지)
  CANCELLED // 취소
}

enum InvoiceType {
  SALES // 매출 계산서
  PURCHASE // 매입 계산서
}

// 상품/MA 2종 (실무 규칙)
enum ProductCategory {
  상품
  MA
}

// 계산서 발행 기록
//
// 식별 규칙 (amendedFromId=null인 체인 루트 기준):
//   - 매출: (approvalId, productId)           — 제품 단위 고정
//   - 매입: (approvalId, vendorCompany)       — 매입처가 자연 키
// source: 'SALES_APPROVAL' → approvalId 필수 / 'MA_BILLING' → maBillingId 필수
enum InvoiceSource {
  SALES_APPROVAL
  MA_BILLING
}

model InvoiceRecord {
  id String @id @default(uuid())

  // 소스 구분 (BUSINESS_RULES §10: MA 계산서는 MABilling에서 파생)
  source InvoiceSource @default(SALES_APPROVAL)

  // 연결 정보 (source에 따라 한 쪽만 채워짐)
  approvalId  String?     @map("approval_id")   // SALES_APPROVAL인 경우
  maBillingId String?     @map("ma_billing_id") // MA_BILLING인 경우
  invoiceType InvoiceType @map("invoice_type")  // SALES or PURCHASE

  // 매출 식별 (SALES일 때 채움)
  productId String? @map("product_id")

  // 매입 식별 (PURCHASE일 때 채움, 매입처가 자연 키)
  vendorCompany String? @map("vendor_company")

  // 공통 메타
  clientCompany String? @map("client_company")

  // 스냅샷 (발행 시점 내용)
  productName String  @map("product_name")
  partNumber  String? @map("part_number")
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(15, 2)

  // 상태/발행 정보
  status        InvoiceStatus @default(PENDING)
  invoiceDate   DateTime?     @map("invoice_date") @db.Date
  invoiceNumber String?       @map("invoice_number")
  remarks       String?       @db.Text

  // 체인/취소
  amendedFromId String?   @map("amended_from_id")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  approval    SalesApproval?  @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  maBilling   MABilling?      @relation(fields: [maBillingId], references: [id], onDelete: Cascade)
  amendedFrom InvoiceRecord?  @relation("InvoiceAmendments", fields: [amendedFromId], references: [id])
  amendments  InvoiceRecord[] @relation("InvoiceAmendments")

  @@index([source])
  @@index([approvalId, invoiceType])
  @@index([approvalId, productId])
  @@index([approvalId, vendorCompany])
  @@index([maBillingId])
  @@index([amendedFromId])
  @@index([status])
  @@map("invoice_records")
}

// ==================== 엑셀 양식 관리 ====================

model ExcelTemplate {
  id   String @id @default(uuid())
  name String // 양식명 (예: "Sales 품의서 v1")

  // 문서 타입
  docType String @map("doc_type") // SALES_QUOTE, SALES_APPROVAL, SALES_ORDER, MA_QUOTE, MA_APPROVAL

  // 샘플 파일 정보
  sampleFileName String? @map("sample_file_name")
  sampleFilePath String? @map("sample_file_path")

  // 필드 매핑 (JSON)
  // { "approvalCode": "D9", "approvalDate": "D10", "clientCompany": "D13", ... }
  fieldMappings Json @default("{}") @map("field_mappings")

  // 품목 테이블 설정
  itemTableHeaderRow Int  @default(16) @map("item_table_header_row") // 헤더 행
  itemTableStartRow  Int  @default(17) @map("item_table_start_row") // 데이터 시작 행
  itemTableEndRow    Int? @map("item_table_end_row") // 데이터 종료 행 (null이면 빈 행까지)

  // 품목 열 매핑 (JSON)
  // { "partNumber": "C", "description": "D", "quantity": "E", "unitPrice": "F", "totalPrice": "G" }
  salesColumnMappings Json @default("{}") @map("sales_column_mappings")

  // 매입 열 매핑 (JSON) - 품의서용
  // { "purchaseDate": "H", "vendorCompany": "I", "purchaseQty": "J", "purchaseUnitPrice": "K", "purchaseTotalPrice": "L" }
  purchaseColumnMappings Json @default("{}") @map("purchase_column_mappings")

  // 메인/하위 품목 구분 설정
  mainItemDetection String? @map("main_item_detection") @db.Text // 메인 품목 감지 방법 (예: "unitPrice > 0")
  subItemDetection  String? @map("sub_item_detection") @db.Text // 하위 품목 감지 방법

  // 합계 행 설정
  totalRowDetection String? @map("total_row_detection") @db.Text // 합계 행 감지 (예: "A열에 '합계' 포함")

  // 분석된 원본 JSON (디버깅/미리보기용)
  analyzedData Json? @map("analyzed_data")

  // 상태
  isActive  Boolean @default(true) @map("is_active")
  isDefault Boolean @default(false) @map("is_default") // 해당 docType의 기본 양식

  // 메타
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([docType, isDefault], map: "unique_default_per_doctype")
  @@index([docType])
  @@index([isActive])
  @@map("excel_templates")
}
