// ==================== 알림 시스템 ====================

enum NotificationType {
  APPROVAL_REQUEST    // 결재 요청
  APPROVAL_APPROVED   // 결재 승인
  APPROVAL_REJECTED   // 결재 반려
  MA_EXPIRING         // MA 만료 예정
  PAYMENT_DUE         // 결제 예정
  SYSTEM              // 시스템 알림
}

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 알림 내용
  type    NotificationType
  title   String            // 알림 제목
  message String @db.Text   // 알림 내용

  // 링크 정보 (클릭 시 이동)
  linkUrl  String? @map("link_url")  // 이동할 URL
  linkType String? @map("link_type") // SALES_APPROVAL, MA_APPROVAL, INVOICE 등

  // 연관 데이터 (선택)
  relatedId   String? @map("related_id")   // 관련 문서 ID
  relatedType String? @map("related_type") // SalesApproval, MAApproval 등

  // 상태
  isRead   Boolean   @default(false) @map("is_read")
  readAt   DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("notifications")
}

